# ---------------------------------------------------------------------------
# Escape Room — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# All values below are placeholders.
# ---------------------------------------------------------------------------

# Flask application secret. REQUIRED in production (the app refuses to boot
# without it when FLASK_ENV=production).
# Generate with:  python -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Set to 1 ONLY when running behind a reverse proxy (nginx, Cloudflare, ...)
# that sets X-Forwarded-For. When 0 (default) the real socket address is used
# for rate limiting, so clients cannot spoof their IP to dodge limits.
TRUST_PROXY=0

# development | production
FLASK_ENV=development

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=instance/escape_room.db

# Public origin used for canonical URLs, sitemap, review links, share links.
# Example: https://example.com  (no trailing slash)
SITE_URL=http://localhost:5000

# Comma separated list of allowed origins for CORS (admin SPA-less, usually empty).
ALLOWED_ORIGINS=

# Timezone used for display of dates/times (IANA name).
TIMEZONE=Asia/Tehran

# Cookie hardening. Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Upload limits (bytes). 5 MB image, 40 MB video.
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=41943040

# Rate limiting
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Customer sign-up: phone number + one-time SMS code, then a password.
# The code lives 2 minutes, repeated wrong guesses are capped, and a resend
# is refused for 45s. While SMS_ENABLED=0 the code is shown on the page
# instead (SIGNUP_SHOW_CODE) - otherwise nobody could finish signing up on
# a machine with no gateway; set it to 0 on a public deployment.
SIGNUP_CODE_TTL_SECONDS=120
SIGNUP_VERIFIED_TTL_SECONDS=900
SIGNUP_RESEND_COOLDOWN_SECONDS=45
SIGNUP_MAX_ATTEMPTS=5
SIGNUP_SHOW_CODE=1


# ---------------------------------------------------------------------------
# SMS provider (leave empty until the business owner subscribes to a provider).
# The application runs fully without these. No real SMS is ever sent while
# SMS_ENABLED=0 or SMS_PROVIDER=mock.
# ---------------------------------------------------------------------------
SMS_ENABLED=0
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
SMS_BASE_URL=

# ---------------------------------------------------------------------------
# Payment gateway (leave empty until the owner provides credentials).
# While PAYMENT_ENABLED=0 the booking flow uses a real reservation-request
# workflow and never fakes a successful payment.
# ---------------------------------------------------------------------------
PAYMENT_ENABLED=0
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_BASE_URL=

# Super-admin bootstrap. Used ONLY by the one-time CLI command
# `python manage.py init-admin`. Leave empty for normal operation.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
